{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "argocd",
    "custom.regex",
    "github-actions",
    "kustomize",
    "kubernetes"
  ],
  "ignorePaths": [
    "apps/app-of-apps.yaml"
  ],
  "automerge": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignoreUnstable": true,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "argocd": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/^apps/.+/helm/.+/base/kustomization\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CloudNativePG Cluster images",
      "managerFilePatterns": [
        "/^apps/(?:authelia|forgejo|immich)/[0-9]+_postgres\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*imageName:\\s*(?<depName>ghcr\\.io/[^:\\s]+):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "description": "Update the Authelia Dragonfly image",
      "managerFilePatterns": [
        "/^apps/authelia/3_dragonfly\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.dragonflydb\\.io/dragonflydb/dragonfly):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://docker.dragonflydb.io"
    },
    {
      "customType": "regex",
      "description": "Update the Grafana custom resource image",
      "managerFilePatterns": [
        "/^apps/grafana/3_grafana\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  version:\\s*docker\\.io/(?<depName>grafana/grafana):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the OpenObserve Helm image tag",
      "managerFilePatterns": [
        "/^apps/openobserve/2_helm\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^            tag:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "openobserve/openobserve",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Operator image tag",
      "managerFilePatterns": [
        "/^apps/rustfs-operator/1_helm\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^            repository:\\s*(?<depName>rustfs/operator)\\s*\\n            tag:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Tenant image",
      "managerFilePatterns": [
        "/^apps/rustfs/2_tenant\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  image:\\s*(?<depName>rustfs/rustfs):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora Helm chart",
      "managerFilePatterns": [
        "/^apps/collabora/helm/collabora-online/base/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^    version:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora-online",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://collaboraonline.github.io/online/"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora image",
      "managerFilePatterns": [
        "/^apps/collabora/helm/collabora-online/base/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  tag:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora/code",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update OpenCloud, Tika, and web extension images",
      "managerFilePatterns": [
        "/^apps/opencloud/4_deployments\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>opencloudeu/opencloud-rolling|apache/tika|opencloudeu/web-extensions):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    }
  ]
}
