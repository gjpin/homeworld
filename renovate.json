      "matchStrings": [
        "(?m)^version:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "ghcr.io/documentdb/documentdb-operator",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
