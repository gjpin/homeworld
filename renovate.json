      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.dragonflydb\\.io/dragonflydb/dragonfly):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://docker.dragonflydb.io"
    },
    {
      "customType": "regex",
      "description": "Update the Authelia image",
      "managerFilePatterns": [
        "/^apps/authelia/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+registry:\\s*ghcr\\.io\\s*\\n\\s+repository:\\s*(?<depName>authelia/authelia)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "description": "Update the Grafana custom resource image",
      "managerFilePatterns": [
        "/^apps/grafana/0_grafana\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  version:\\s*docker\\.io/(?<depName>grafana/grafana):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the OpenObserve image tag",
      "managerFilePatterns": [
        "/^apps/openobserve/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+oss:\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "openobserve/openobserve",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Operator image tag",
      "managerFilePatterns": [
        "/^apps/rustfs-operator/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^operator:\\s*\\n\\s+image:\\s*\\n\\s+repository:\\s*(?<depName>rustfs/operator)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Tenant image",
      "managerFilePatterns": [
        "/^apps/rustfs/0_tenant\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  image:\\s*(?<depName>rustfs/rustfs):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora Helm chart",
      "managerFilePatterns": [
        "/^apps/collabora/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^    version:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora-online",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://collaboraonline.github.io/online/"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora image",
      "managerFilePatterns": [
        "/^apps/collabora/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  tag:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora/code",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update OpenCloud, Tika, and web extension images",
      "managerFilePatterns": [
        "/^apps/opencloud/1_deployments\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>opencloudeu/opencloud-rolling|opencloudeu/yjs|apache/tika|opencloudeu/web-extensions):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update Prometheus Operator CRDs",
      "managerFilePatterns": [
        "/^apps/prometheus-operator-crd/0_crds\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)repoURL:\\s+https://github\\.com/(?<depName>prometheus-operator/prometheus-operator)\\.git\\s+targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Radicale image",
      "managerFilePatterns": [
        "/^apps/radicale/1_deployment\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.io/opencloudeu/radicale):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Operator Helm chart",
      "managerFilePatterns": [
        "/^apps/rustfs-operator/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+rustfs-operator\\s+repo:\\s+https://operator\\.rustfs\\.com\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "rustfs-operator",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://operator.rustfs.com"
    },
    {
      "customType": "regex",
      "description": "Update the Velero Helm chart",
      "managerFilePatterns": [
        "/^apps/velero/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+velero\\s+repo:\\s+https://vmware-tanzu\\.github\\.io/helm-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "velero",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
