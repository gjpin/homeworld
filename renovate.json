      ],
      "depNameTemplate": "docker.io/envoyproxy/gateway-helm",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Forgejo Helm chart",
      "managerFilePatterns": [
