      "matchStrings": [
        "(?ms)^\\s+- name:\\s+immich\\s+repo:\\s+oci://ghcr\\.io/immich-app/immich-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-charts/immich",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Grafana Operator Helm chart",
      "managerFilePatterns": [
        "/^apps/grafana-operator/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+grafana-operator\\s+repo:\\s+oci://ghcr\\.io/grafana/helm-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/grafana/helm-charts/grafana-operator",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",

      "description": "Update Gateway API CRDs",
      "managerFilePatterns": [
        "/^apps/envoy-gateway/0_crds\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)repoURL:\\s+https://github\\.com/(?<depName>kubernetes-sigs/gateway-api)\\.git\\s+targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the ExternalDNS Helm chart",
      "managerFilePatterns": [
