{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "argocd",
    "custom.regex",
    "github-actions",
    "kustomize",
    "kubernetes"
  ],
  "ignorePaths": [
    "apps/app-of-apps.yaml"
  ],
  "automerge": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignoreUnstable": true,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "separateMultipleMajor": false,
  "argocd": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/^apps/.+/helm(?:/.+)?/kustomization\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CloudNativePG Cluster images",
      "managerFilePatterns": [
        "/^apps/(?:authelia|crowdsec|forgejo|immich)/[0-9]+_postgres\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*imageName:\\s*(?<depName>ghcr\\.io/[^:\\s]+):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "description": "Update the CrowdSec Helm chart",
      "managerFilePatterns": [
        "/^apps/crowdsec/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+crowdsec\\s+repo:\\s+https://crowdsecurity\\.github\\.io/helm-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "crowdsec",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://crowdsecurity.github.io/helm-charts"
    },
    {
      "customType": "regex",
      "description": "Update the CrowdSec image",
      "managerFilePatterns": [
        "/^apps/crowdsec/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+repository:\\s*(?<depName>crowdsecurity/crowdsec)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the CrowdSec kubectl helper image",
      "managerFilePatterns": [
        "/^apps/crowdsec/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+kubectl:\\s*\\n\\s+repository:\\s*(?<depName>alpine/kubectl)\\s*\\n\\s+tag:\\s*[\"']?(?<currentValue>[^\"'\\s#]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Envoy bouncer Helm chart",
      "managerFilePatterns": [
        "/^apps/crowdsec-envoy-bouncer/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+envoy-proxy-bouncer\\s+repo:\\s+oci://ghcr\\.io/kdwils/charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/kdwils/charts/envoy-proxy-bouncer",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Envoy bouncer image",
      "managerFilePatterns": [
        "/^apps/crowdsec-envoy-bouncer/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+repository:\\s*(?<depName>ghcr\\.io/kdwils/envoy-proxy-bouncer)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "description": "Update the Dragonfly Operator Helm chart",
      "managerFilePatterns": [
        "/^apps/dragonfly-operator/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+dragonfly-operator\\s+repo:\\s+oci://ghcr\\.io/dragonflydb/dragonfly-operator/helm\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Envoy Gateway Helm chart",
      "managerFilePatterns": [
        "/^apps/envoy-gateway/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+gateway-helm\\s+repo:\\s+oci://docker\\.io/envoyproxy\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "docker.io/envoyproxy/gateway-helm",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Forgejo Helm chart",
      "managerFilePatterns": [
        "/^apps/forgejo/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+forgejo\\s+repo:\\s+oci://code\\.forgejo\\.org/forgejo-helm\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "code.forgejo.org/forgejo-helm/forgejo",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Immich Helm chart",
      "managerFilePatterns": [
        "/^apps/immich/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+immich\\s+repo:\\s+oci://ghcr\\.io/immich-app/immich-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-charts/immich",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Grafana Operator Helm chart",
      "managerFilePatterns": [
        "/^apps/grafana-operator/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+grafana-operator\\s+repo:\\s+oci://ghcr\\.io/grafana/helm-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "ghcr.io/grafana/helm-charts/grafana-operator",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",

      "description": "Update Gateway API CRDs",
      "managerFilePatterns": [
        "/^apps/envoy-gateway/1_crds\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)repoURL:\\s+https://github\\.com/(?<depName>kubernetes-sigs/gateway-api)\\.git\\s+targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the ExternalDNS Helm chart",
      "managerFilePatterns": [
        "/^apps/external-dns/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+external-dns\\s+repo:\\s+https://kubernetes-sigs\\.github\\.io/external-dns\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "external-dns",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://kubernetes-sigs.github.io/external-dns"
    },
    {
      "customType": "regex",
      "description": "Update the Authelia Dragonfly image",
      "managerFilePatterns": [
        "/^apps/authelia/3_dragonfly\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.dragonflydb\\.io/dragonflydb/dragonfly):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://docker.dragonflydb.io"
    },
    {
      "customType": "regex",
      "description": "Update the Authelia image",
      "managerFilePatterns": [
        "/^apps/authelia/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+registry:\\s*ghcr\\.io\\s*\\n\\s+repository:\\s*(?<depName>authelia/authelia)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io"
    },
    {
      "customType": "regex",
      "description": "Update the Grafana custom resource image",
      "managerFilePatterns": [
        "/^apps/grafana/3_grafana\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  version:\\s*docker\\.io/(?<depName>grafana/grafana):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the OpenObserve image tag",
      "managerFilePatterns": [
        "/^apps/openobserve/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^image:\\s*\\n\\s+oss:\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "openobserve/openobserve",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Operator image tag",
      "managerFilePatterns": [
        "/^apps/rustfs-operator/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^operator:\\s*\\n\\s+image:\\s*\\n\\s+repository:\\s*(?<depName>rustfs/operator)\\s*\\n\\s+tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Tenant image",
      "managerFilePatterns": [
        "/^apps/rustfs/2_tenant\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  image:\\s*(?<depName>rustfs/rustfs):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora Helm chart",
      "managerFilePatterns": [
        "/^apps/collabora/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^    version:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora-online",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://collaboraonline.github.io/online/"
    },
    {
      "customType": "regex",
      "description": "Update the Collabora image",
      "managerFilePatterns": [
        "/^apps/collabora/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^  tag:\\s*(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "depNameTemplate": "collabora/code",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update OpenCloud, Tika, and web extension images",
      "managerFilePatterns": [
        "/^apps/opencloud/4_deployments\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>opencloudeu/opencloud-rolling|opencloudeu/yjs|apache/tika|opencloudeu/web-extensions):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update Prometheus Operator CRDs",
      "managerFilePatterns": [
        "/^apps/prometheus-operator-crd/1_crds\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)repoURL:\\s+https://github\\.com/(?<depName>prometheus-operator/prometheus-operator)\\.git\\s+targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Radicale image",
      "managerFilePatterns": [
        "/^apps/radicale/2_deployment\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.io/opencloudeu/radicale):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Syncthing image",
      "managerFilePatterns": [
        "/^apps/syncthing/2_deployment\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>docker\\.io/syncthing/syncthing):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the RustFS Operator Helm chart",
      "managerFilePatterns": [
        "/^apps/rustfs-operator/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+rustfs-operator\\s+repo:\\s+https://operator\\.rustfs\\.com\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "rustfs-operator",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://operator.rustfs.com"
    },
    {
      "customType": "regex",
      "description": "Update the Velero Helm chart",
      "managerFilePatterns": [
        "/^apps/velero/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+velero\\s+repo:\\s+https://vmware-tanzu\\.github\\.io/helm-charts\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "velero",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://vmware-tanzu.github.io/helm-charts"
    },
    {
      "customType": "regex",
      "description": "Update the Velero AWS plugin image",
      "managerFilePatterns": [
        "/^apps/velero/helm/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?m)^\\s*image:\\s*(?<depName>velero/velero-plugin-for-aws):(?<currentValue>[^\\s#]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io"
    },
    {
      "customType": "regex",
      "description": "Update the Velero-UI Helm chart",
      "managerFilePatterns": [
        "/^apps/velero-ui/helm/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "(?ms)^\\s+- name:\\s+velero-ui\\s+repo:\\s+https://helm\\.otwld\\.com\\s+version:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "depNameTemplate": "velero-ui",
      "datasourceTemplate": "helm",
      "versioningTemplate": "helm",
      "registryUrlTemplate": "https://helm.otwld.com"
    }
  ]
}
