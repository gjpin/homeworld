---
theme: auto
default_2fa_method: totp
server:
  address: tcp://0.0.0.0:9091
  endpoints:
    rate_limits:
      session_elevation_start:
        enable: true
        buckets:
          - period: 1 hour
            requests: 3
          - period: 1 day
            requests: 5
      openid_connect_token:
        enable: true
        buckets:
          - period: 1 minute
            requests: 30
log:
  level: info
  format: json
telemetry:
  metrics:
    enabled: true
    address: tcp://0.0.0.0:9959
identity_validation:
  elevated_session:
    require_second_factor: true
totp:
  disable: false
  issuer: auth.${BASE_DOMAIN}
webauthn:
  disable: false
  display_name: Homeworld
ntp:
  address: udp://time.cloudflare.com:123
authentication_backend:
  password_reset:
    disable: true
  password_change:
    disable: true
  file:
    path: /secrets/authelia-files/users_database.yml
    watch: false
    password:
      algorithm: argon2
      argon2:
        variant: argon2id
access_control:
  default_policy: two_factor
session:
  cookies:
    - domain: ${BASE_DOMAIN}
      authelia_url: https://auth.${BASE_DOMAIN}
      default_redirection_url: https://cloud.${BASE_DOMAIN}
  redis:
    host: dragonfly.authelia.svc.cluster.local
    port: 6379
regulation:
  modes:
    - user
    - ip
  max_retries: 3
  find_time: 2 minutes
  ban_time: 5 minutes
storage:
  postgres:
    address: tcp://authelia-rw.authelia.svc.cluster.local:5432
    database: authelia
    username: authelia
notifier:
  disable_startup_check: true
  smtp:
    address: submissions://${AUTHELIA_SMTP_HOST}:465
    username: ${AUTHELIA_SMTP_USERNAME}
    sender: ${AUTHELIA_SMTP_SENDER}
definitions:
  user_attributes:
    immich_role:
      expression: '"immich-admin" in groups ? "admin" : "user"'
identity_providers:
  oidc:
    lifespans:
      refresh_token: 30 days
    claims_policies:
      # Authelia 4.39 removed groups/email/name/preferred_username from ID
      # tokens by default (they are served via the UserInfo endpoint). This
      # policy restores them for clients that read claims from the token
      # instead of hydrating UserInfo — Argo CD notably has no
      # enableUserInfoGroups in its oidc.config, so removing it would break
      # Argo CD group mapping (docs/oidc.md).
      apps:
        id_token:
          - preferred_username
          - email
          - name
          - groups
        access_token:
          - preferred_username
          - email
          - name
          - groups
      immich:
        id_token:
          - preferred_username
          - email
          - name
          - groups
          - immich_role
        access_token:
          - preferred_username
          - email
          - name
          - groups
          - immich_role
        custom_claims:
          immich_role:
            attribute: immich_role
      opencloud:
        access_token:
          - preferred_username
          - email
          - name
          - groups
    authorization_policies:
      opencloud:
        default_policy: deny
        rules:
          - policy: two_factor
            subject:
              - group:opencloud-admin
              - group:opencloud-spaceadmin
              - group:opencloud-user
              - group:opencloud-user-light
      # Platform gates the Envoy Gateway OIDC routes (the browser UIs without
      # usable app-native auth). "platform" deliberately breaks the
      # <app>-admin/<app>-user naming: it is a cross-app group, not tied to a
      # single application (docs/oidc.md).
      platform:
        default_policy: deny
        rules:
          - policy: two_factor
            subject:
              - group:platform
      # Argo CD grants non-admins no access (policy.default is empty), so
      # sign-in is limited to the group that maps to role:admin.
      argocd:
        default_policy: deny
        rules:
          - policy: two_factor
            subject:
              - group:argocd-admin
    jwks:
      - key_id: opencloud-rs256
        algorithm: RS256
        use: sig
        key: {{ secret "/secrets/authelia-files/oidc_jwk_rs256.pem" | mindent 10 "|" | msquote }}
    scopes:
      immich:
        claims:
          - immich_role
    cors:
      endpoints:
        - authorization
        - token
        - revocation
        - userinfo
      allowed_origins_from_client_redirect_uris: true
      allowed_origins:
        - https://cloud.${BASE_DOMAIN}
        - https://grafana.${BASE_DOMAIN}
        - https://git.${BASE_DOMAIN}
        - https://argocd.${BASE_DOMAIN}
        - https://photos.${BASE_DOMAIN}
        - https://velero.${BASE_DOMAIN}
        - https://console.rustfs.${BASE_DOMAIN}
        - https://vault.${BASE_DOMAIN}
        - https://home.${BASE_DOMAIN}
    clients:
      # OpenCloud clients deviate from the official Authelia guide
      # (https://www.authelia.com/integration/openid-connect/clients/opencloud/)
      # in three deliberate ways; all three are internally consistent with
      # apps/opencloud/1_deployments.yaml and docs/oidc.md:
      #   1. Client IDs are `web` / `OpenCloudDesktop` / `OpenCloudAndroid` /
      #      `OpenCloudIOS` instead of the guide's opencloud/opencloud-desktop/
      #      opencloud-android/opencloud-ios — matching OC_OIDC_CLIENT_ID and
      #      the WEBFINGER_* URLs the OpenCloud web config uses.
      #   2. authorization_policy is the `opencloud` group gate (deny by
      #      default; only the opencloud-admin/spaceadmin/user/user-light
      #      groups may sign in) instead of the guide's two_factor — a
      #      least-privilege restriction, not a relaxation.
      #   3. claims_policy `opencloud` restores group claims in the ACCESS
      #      token: OpenCloud verifies the access token as a JWT
      #      (PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt) and maps
      #      PROXY_ROLE_ASSIGNMENT_* from the oidc/groups claim, so it needs
      #      them embedded there rather than hydrated from UserInfo.
      - client_id: web
        client_name: OpenCloud Web
        public: true
        token_endpoint_auth_method: none
        authorization_policy: opencloud
        claims_policy: opencloud
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        access_token_signed_response_alg: RS256
        userinfo_signed_response_alg: 'none'
        redirect_uris:
          - https://cloud.${BASE_DOMAIN}/
          - https://cloud.${BASE_DOMAIN}/oidc-callback.html
          - https://cloud.${BASE_DOMAIN}/oidc-silent-redirect.html
        scopes: &opencloud_scopes
          - openid
          - profile
          - email
          - groups
          - offline_access
        grant_types: &opencloud_grants
          - authorization_code
          - refresh_token
        response_types: &opencloud_responses
          - code
      - client_id: OpenCloudDesktop
        client_name: OpenCloud Desktop
        public: true
        token_endpoint_auth_method: none
        authorization_policy: opencloud
        claims_policy: opencloud
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        access_token_signed_response_alg: RS256
        userinfo_signed_response_alg: 'none'
        redirect_uris:
          - http://127.0.0.1
          - http://localhost
        scopes: *opencloud_scopes
        grant_types: *opencloud_grants
        response_types: *opencloud_responses
      - client_id: OpenCloudAndroid
        client_name: OpenCloud Android
        public: true
        token_endpoint_auth_method: none
        authorization_policy: opencloud
        claims_policy: opencloud
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        access_token_signed_response_alg: RS256
        userinfo_signed_response_alg: 'none'
        redirect_uris:
          - oc://android.opencloud.eu
        scopes: *opencloud_scopes
        grant_types: *opencloud_grants
        response_types: *opencloud_responses
      - client_id: OpenCloudIOS
        client_name: OpenCloud iOS
        public: true
        token_endpoint_auth_method: none
        authorization_policy: opencloud
        claims_policy: opencloud
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        access_token_signed_response_alg: RS256
        userinfo_signed_response_alg: 'none'
        redirect_uris:
          - oc://ios.opencloud.eu
          - oc.ios://ios.opencloud.eu
        scopes: *opencloud_scopes
        grant_types: *opencloud_grants
        response_types: *opencloud_responses
      # Deviates from the official grafana guide (RS256 access tokens
      # instead of `none`): Grafana consumes the access token as a UserInfo
      # bearer JWT, which RS256 satisfies; the repo-wide RS256 rule keeps
      # every confidential client's tokens verifiable.
      - client_id: grafana
        client_name: Grafana
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_grafana" | msquote }}
        public: false
        authorization_policy: two_factor
        claims_policy: apps
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://grafana.${BASE_DOMAIN}/login/generic_oauth
        scopes: &app_scopes
          - openid
          - profile
          - email
          - groups
        grant_types: &app_grants
          - authorization_code
        response_types: &app_responses
          - code
      # Deviates from the official forgejo guide (RS256 access tokens
      # instead of `none`): Forgejo's OIDC library validates signed access
      # tokens at the UserInfo endpoint, which RS256 satisfies.
      - client_id: forgejo
        client_name: Forgejo
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_forgejo" | msquote }}
        public: false
        authorization_policy: two_factor
        claims_policy: apps
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://git.${BASE_DOMAIN}/user/oauth2/Authelia/callback
        scopes: *app_scopes
        grant_types: *app_grants
        response_types: *app_responses
      # Deviates from the official argocd guide (require_pkce: true +
      # RS256 + the profile scope instead of the guide's no-PKCE /
      # access_token: none): Argo CD supports PKCE S256
      # (enablePKCEAuthentication), the shared `apps` claims policy embeds
      # groups in the ID token for the no-UserInfo role mapping, and RS256
      # access tokens validate as UserInfo bearers.
      - client_id: argocd
        client_name: Argo CD
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_argocd" | msquote }}
        public: false
        authorization_policy: argocd
        claims_policy: apps
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://argocd.${BASE_DOMAIN}/auth/callback
        scopes: *app_scopes
        grant_types: *app_grants
        response_types: *app_responses
      - client_id: argocd-cli
        client_name: Argo CD (CLI)
        public: true
        token_endpoint_auth_method: none
        authorization_policy: argocd
        claims_policy: apps
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        access_token_signed_response_alg: RS256
        redirect_uris:
          - http://localhost:8085/auth/callback
        # `profile` must be granted here even though the browser client's
        # guide omits it: Argo CD's oidc.config requests the same
        # requestedScopes for the browser and CLI flows (one config block,
        # cliClientID), so Authelia would reject `argocd login --sso` with
        # invalid_scope while browser login kept working.
        scopes:
          - openid
          - profile
          - offline_access
          - groups
          - email
        grant_types:
          - authorization_code
          - refresh_token
        response_types:
          - code
      # Deviates from the official immich guide (RS256 access tokens instead of
      # none, plus groups/immich scopes with the immich claims policy mapping groups to the immich_role admin/user claim).
      - client_id: immich
        client_name: Immich
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_immich" | msquote }}
        public: false
        authorization_policy: two_factor
        claims_policy: immich
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://photos.${BASE_DOMAIN}/auth/login
          - https://photos.${BASE_DOMAIN}/user-settings
          - app.immich:///oauth-callback
        scopes:
          - openid
          - profile
          - email
          - groups
          - immich
        grant_types: *app_grants
        response_types: *app_responses
      - client_id: velero-ui
        client_name: Velero UI
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_velero_ui" | msquote }}
        public: false
        # velero-ui has no roles: every session can restore and delete any
        # backup, so sign-in is gated to the platform group.
        authorization_policy: platform
        claims_policy: apps
        # velero-ui's passport-oauth2 flow sends no PKCE, so it cannot be
        # required for this client.
        require_pkce: false
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        # velero-ui's passport-oauth2/oauth library only supports sending
        # the client secret in the POST body.
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://velero.${BASE_DOMAIN}/login
        scopes: *app_scopes
        grant_types: *app_grants
        response_types: *app_responses
      - client_id: rustfs
        client_name: RustFS
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_rustfs" | msquote }}
        public: false
        # The platform group maps to RustFS's full-admin platform policy
        # (apps/rustfs/0_user_policies.yaml), so sign-in is gated to that
        # group rather than any two-factor user.
        authorization_policy: platform
        claims_policy: apps
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        # The RustFS console sets AuthType::RequestBody in its openidconnect
        # client; it only supports sending the secret in the POST body.
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://console.rustfs.${BASE_DOMAIN}/rustfs/admin/v3/oidc/callback/default
          - https://console.rustfs.${BASE_DOMAIN}/rustfs/admin/v3/oidc/callback
        scopes: *app_scopes
        grant_types: *app_grants
        response_types: *app_responses
      # Deviates from the official vaultwarden guide (RS256 access tokens
      # instead of `none`): upstream vaultwarden consumes the access token
      # as a UserInfo bearer, which RS256 satisfies. PKCE stays required
      # per the repo-wide rule.
      - client_id: vaultwarden
        client_name: Vaultwarden
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_vaultwarden" | msquote }}
        public: false
        authorization_policy: two_factor
        # No claims_policy: upstream vaultwarden has no SSO role mapping; admins are assigned in the admin panel.
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://vault.${BASE_DOMAIN}/identity/connect/oidc-signin
        # offline_access / refresh_token grant let Vaultwarden extend SSO
        # sessions without re-prompting.
        scopes:
          - openid
          - profile
          - email
          - offline_access
        grant_types:
          - authorization_code
          - refresh_token
        response_types: *app_responses
      # Deviates from the official home-assistant guide (RS256 access
      # tokens instead of `none`): the hass-oidc-auth plugin consumes the
      # access token as a UserInfo bearer, which RS256 satisfies.
      - client_id: home-assistant
        client_name: Home Assistant
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_homeassistant" | msquote }}
        public: false
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        # hass-oidc-auth cannot send HTTP Basic auth headers.
        token_endpoint_auth_method: client_secret_post
        access_token_signed_response_alg: RS256
        redirect_uris:
          - https://home.${BASE_DOMAIN}/auth/oidc/callback
        scopes:
          - openid
          - profile
          - groups
        grant_types:
          - authorization_code
        response_types:
          - code
      # Envoy Gateway itself is the OIDC client for the browser UIs that
      # have no usable app-native auth: victoria-metrics, victoria-logs,
      # victoria-traces, longhorn, homepage, the Envoy Gateway admin console
      # (envoy.${BASE_DOMAIN} backs onto the controller's 19000 admin port),
      # and zigbee2mqtt. Each host gets its own
      # HTTPRoute-scoped SecurityPolicy with a per-host redirect URL and
      # cookie domain (docs/oidc.md).
      # Reference: https://www.authelia.com/integration/openid-connect/clients/envoy-gateway/
      - client_id: envoy
        client_name: Envoy Gateway
        client_secret: {{ secret "/secrets/authelia-files/oidc_client_secret_envoy" | msquote }}
        public: false
        authorization_policy: platform
        # Envoy's oauth2 filter does not send PKCE, so it cannot be required
        # for this client.
        require_pkce: false
        consent_mode: pre-configured
        pre_configured_consent_duration: 1 week
        token_endpoint_auth_method: client_secret_basic
        # The access token never leaves Envoy's encrypted session cookie
        # (every SecurityPolicy sets forwardAccessToken: false) and is never
        # validated as a JWT, so it stays opaque.
        access_token_signed_response_alg: none
        # No claims_policy: Envoy only validates the ID token's issuer,
        # audience, and expiry; no claims are read or forwarded.
        redirect_uris:
          - https://victoria-metrics.${BASE_DOMAIN}/oauth2/callback
          - https://victoria-logs.${BASE_DOMAIN}/oauth2/callback
          - https://victoria-traces.${BASE_DOMAIN}/oauth2/callback
          - https://longhorn.${BASE_DOMAIN}/oauth2/callback
          - https://homepage.${BASE_DOMAIN}/oauth2/callback
          - https://envoy.${BASE_DOMAIN}/oauth2/callback
          - https://z2m.${BASE_DOMAIN}/oauth2/callback
        # offline_access backs the SecurityPolicies' refreshToken: true,
        # which renews gateway sessions without a new authorization flow.
        scopes:
          - openid
          - offline_access
        grant_types:
          - authorization_code
          - refresh_token
        response_types:
          - code
