        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "max by (node) (kured_reboot_required{namespace=\"kured\"})",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "Reboot required by node",
