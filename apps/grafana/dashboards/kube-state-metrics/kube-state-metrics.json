          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(kube_deployment_spec_replicas{job=~\".*kube-state-metrics.*\", namespace=~\"$namespace\"})",
          "legendFormat": "desired"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(kube_deployment_status_replicas_available{job=~\".*kube-state-metrics.*\", namespace=~\"$namespace\"})",
          "legendFormat": "available"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(kube_statefulset_status_replicas_ready{job=~\".*kube-state-metrics.*\", namespace=~\"$namespace\"})",
          "legendFormat": "statefulset ready"
        }
      ],
      "title": "Replicas: desired vs available",
      "type": "timeseries"
    },
    {
