  "description": "Custom dashboard for the kubernetes-csi external-snapshotter snapshot-controller (upstream ships no dashboard). Metric families are the controller-runtime instrumentation exported on the deployment's :8080 metrics endpoint: workqueue_*, rest_client_*, go_*, process_* (verified against the controller-runtime version the pinned release builds on). Scoped to the namespace target label of the homeworld OpenTelemetry pipeline; datasource hardcoded to the in-cluster victoriametrics uid.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum by (le, name) (rate(workqueue_queue_duration_seconds_bucket{namespace=\"snapshot-controller\"}[$__rate_interval])))",
          "legendFormat": "{{name}} p99"
        }
      ],
      "title": "Workqueue queue duration (p99)",
      "type": "timeseries"
    },
