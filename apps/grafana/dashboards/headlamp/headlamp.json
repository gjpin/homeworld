  },
  "description": "Headlamp backend requests, cluster proxy traffic and errors. Metrics verified against Headlamp v0.46.0 backend/pkg/telemetry/metrics.go (http.server.request_count, http.server.duration, http.server.active_requests, headlamp.cluster_proxy.requests and headlamp.errors, as named by its OpenTelemetry Prometheus exporter) plus the Go runtime and process collectors; the project publishes no dashboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "description": "Scrape health of the Headlamp backend metrics endpoint (:4466).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(up{namespace=\"headlamp\"})",
          "legendFormat": "up",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Up",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "description": "In-flight HTTP requests.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(http_server_active_requests{namespace=\"headlamp\"})",
          "legendFormat": "active",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active requests",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "description": "HTTP requests per second, by status code.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (http_status_code) (rate(http_server_request_count_total{namespace=\"headlamp\"}[5m]))",
          "legendFormat": "{{http_status_code}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Requests by status",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "description": "p50 and p95 HTTP request duration.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
