# Pinned tool versions installed into /usr/local of the agents VM by
# provision.sh. Renovate's custom managers (renovate.json) bump each line;
# a change rebuilds the VM root in the 02:00-02:30 window (docs/agents-vm.md).
# Fedora packages (Node.js 26, Podman, the toolchains) follow the VM's
# FEDORA_RELEASE (host/versions.env) and dnf5-automatic instead.
# renovate: datasource=npm depName=@openchamber/web
OPENCHAMBER_VERSION=2.6.1
# renovate: datasource=github-releases depName=anomalyco/opencode versioning=semver extractVersion=^v(?<version>.+)$
OPENCODE_VERSION=2.2.6
# renovate: datasource=npm depName=@anthropic-ai/claude-code
CLAUDE_CODE_VERSION=2.1.319
# renovate: datasource=github-releases depName=openai/codex versioning=semver extractVersion=^rust-v(?<version>.+)$
CODEX_VERSION=0.167.0
# renovate: datasource=npm depName=@earendil-works/pi-coding-agent
PI_AGENT_VERSION=1.5.0
# renovate: datasource=custom.antigravity-cli depName=antigravity-cli versioning=semver
ANTIGRAVITY_VERSION=1.5.3
# renovate: datasource=github-releases depName=github/copilot-cli versioning=semver extractVersion=^v(?<version>.+)$
COPILOT_VERSION=1.0.107
# renovate: datasource=pypi depName=mistral-vibe
VIBE_VERSION=3.1.0
# renovate: datasource=npm depName=@getpaseo/cli
PASEO_VERSION=0.15.3
# renovate: datasource=github-releases depName=JetBrains/thinkrail versioning=semver extractVersion=^v(?<version>.+)$
THINKRAIL_VERSION=0.3.2
# renovate: datasource=npm depName=@playwright/test
PLAYWRIGHT_TEST_VERSION=1.65.0
# renovate: datasource=npm depName=@playwright/cli
PLAYWRIGHT_CLI_VERSION=0.1.23
# renovate: datasource=npm depName=chrome-devtools-mcp
CHROME_DEVTOOLS_MCP_VERSION=1.12.0
# renovate: datasource=npm depName=skills
SKILLS_VERSION=1.7.6
# renovate: datasource=github-releases depName=Infisical/cli versioning=semver extractVersion=^v(?<version>.+)$
INFISICAL_VERSION=0.45.4
# renovate: datasource=go depName=mvdan.cc/sh/v3
SHFMT_VERSION=v3.14.1
