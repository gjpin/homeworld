# Ryzen 7 3700X desktop: VM host for the agents VM.
EXPECTED_ARCH=x86_64
EXPECTED_CPU_VENDOR=AuthenticAMD
MIN_MEMORY_GIB=30
AGENTS_VM=1
# The agents VM's 16 GiB plus 1 GiB for the host itself.
SYSTEM_RESERVED_MEMORY=17Gi
# Longhorn leaves the OS, container images and the agents VM disks
# (40 GiB root + 160 GiB home) free.
LONGHORN_RESERVED_GIB=240
