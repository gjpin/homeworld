# Rendered by host/apply.sh into /etc/rancher/k3s/authentication.yaml. The API
# server reloads this file while running, and retries the issuer in the
# background, so it starts without Authelia (docs/k3s.md).
# https://kubernetes.io/docs/reference/access-authn-authz/authentication/#using-authentication-configuration
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
# k3s only passes --anonymous-auth=false when it has no authentication-config.
anonymous:
  enabled: false
jwt:
  # Headlamp forwards its users' ID tokens (apps/headlamp/0_rbac.yaml). The
  # oidc: prefix stops an Authelia group from claiming a system: group.
  - issuer:
      url: https://auth.@BASE_DOMAIN@
      audiences:
        - headlamp
    claimMappings:
      username:
        claim: preferred_username
        prefix: "oidc:"
      groups:
        claim: groups
        prefix: "oidc:"
