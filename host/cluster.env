# Cluster coordinates shared by every node. Literal values: Argo CD and
# these host scripts deploy straight from git (see AGENTS.md). Node IPs are
# deliberately not here; bootstrap.sh records them per node in
# /etc/homeworld/env.
LAN_CIDR=192.168.8.0/24
WIREGUARD_CIDR=10.10.0.0/24
ROUTER_IP=192.168.8.1
NAS_IP=192.168.8.20
GATEWAY_VIP=192.168.8.50
API_VIP=192.168.8.51
# apps/envoy-gateway/0_node_access_service.yaml
GATEWAY_CLUSTER_IP=10.43.0.50
TANG_URL=http://192.168.8.1:7500
POD_CIDR=10.42.0.0/16
SERVICE_CIDR=10.43.0.0/16
AGENTS_CIDR=10.20.0.0/24
AGENTS_GATEWAY=10.20.0.1
AGENTS_VM_IP=10.20.0.10
AGENTS_VM_MAC=52:54:00:20:00:10
TIMEZONE=Europe/Lisbon
REPO_TARBALL=https://codeload.github.com/gjpin/homeworld/tar.gz/refs/heads/main
