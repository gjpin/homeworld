# Pinned host component versions. Renovate's custom managers (renovate.json)
# bump each line; apply.sh converges every node on them.

# Fedora release: a bump stages an offline upgrade that kured applies one
# node at a time (docs/fedora.md).
# renovate: datasource=endoflife-date depName=fedora versioning=loose
FEDORA_RELEASE=45

# Only bootstrap.sh installs this k3s version; system-upgrade-controller owns
# every upgrade after that (apps/system-upgrade-controller).
# renovate: datasource=github-releases depName=k3s-io/k3s versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\+k3s(?<build>\d+)$
K3S_VERSION=v1.37.1+k3s1

# gVisor runsc, containerd-shim-runsc-v1 and the gvisor-bin sidecars.
# renovate: datasource=github-tags depName=google/gvisor versioning=loose extractVersion=^release-(?<version>\d+\.\d+)$
GVISOR_VERSION=20261012.0

# kube-vip static pod (Kubernetes API VIP).
# renovate: datasource=docker depName=ghcr.io/kube-vip/kube-vip versioning=semver
KUBE_VIP_VERSION=v1.3.0

# helm, used only by bootstrap.sh to render the first Cilium and Argo CD
# manifests (kubectl kustomize --enable-helm).
# renovate: datasource=github-releases depName=helm/helm versioning=semver
HELM_VERSION=v4.3.1
