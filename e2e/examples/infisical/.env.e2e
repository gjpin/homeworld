# Local-only Infisical defaults for E2E. NOT real secrets — safe to commit.
# Do not reuse these values outside disposable e2e environments.

# Infisical application
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AUTH_SECRET=e2e-only-auth-secret-do-not-use-elsewhere-32b
SITE_URL=http://127.0.0.1:8080
TELEMETRY_ENABLED=false

# Postgres (compose service "db")
POSTGRES_USER=infisical
POSTGRES_PASSWORD=e2e-infisical-db
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://infisical:e2e-infisical-db@db:5432/infisical

# Redis (compose service "redis")
REDIS_URL=redis://redis:6379
